  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.2.0",
    "linkedom": "^0.18.12",
    "turndown": "^7.2.4",
    "unpdf": "^1.6.2"
  }
}

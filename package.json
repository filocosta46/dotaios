{
  "name": "dotaios",
  "version": "1.14.4",
  "description": "Dotfiles for AI agents: local-first personal context for Claude Code, Codex, Cursor, and other assistants.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filocosta46/dotaios.git"
  },
  "homepage": "https://github.com/filocosta46/dotaios#readme",
  "bugs": {
    "url": "https://github.com/filocosta46/dotaios/issues"
  },
  "author": "Filippo Costa",
  "bin": {
    "dotaios": "packages/cli/src/index.mjs",
    "aios": "packages/cli/src/index.mjs",
    "dotaios-mcp": "packages/mcp/src/server.mjs"
  },
  "files": [
    "packages/cli/src",
    "packages/core/src",
    "packages/mcp/src",
    "templates",
    "skills",
    "docs/architecture.md",
    "docs/beta-testing.md",
    "docs/context-import.md",
    "docs/friend-setup.md",
    "docs/getting-started.md",
    "docs/google-workspace.md",
    "docs/marketplace.md",
    "docs/mcp.md",
    "docs/plugin-development.md",
    "docs/adapters.md",
    "docs/schedules.md",
    "docs/security.md",
    "docs/sessions.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "cli": "node packages/cli/src/index.mjs",
    "check": "node packages/cli/src/index.mjs --help",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "ai",
    "agents",
    "memory",
    "cli",
    "context",
    "claude-code",
    "codex",
    "cursor"

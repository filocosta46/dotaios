{
  "agents": [
    { "name": "Claude Code", "detect": ".claude", "command": "claude", "bridge": ".claude/CLAUDE.md", "include": "@",
      "skills": { "mode": "symlink", "dir": ".claude/skills", "project": { "mode": "symlink", "dir": ".claude/skills" } } },
    { "name": "Codex", "detect": ".codex", "command": "codex", "bridge": ".codex/AGENTS.md", "include": "",
      "skills": { "mode": "symlink", "dir": ".agents/skills", "project": { "mode": "symlink", "dir": ".agents/skills" } } },
    { "name": "Gemini", "detect": ".gemini", "command": "gemini", "bridge": ".gemini/GEMINI.md", "include": "@",
      "skills": { "mode": "symlink", "dir": ".agents/skills", "project": { "mode": "symlink", "dir": ".agents/skills" } } },
    { "name": "Cursor", "detect": ".cursor", "bridge": null, "include": "",
      "skills": { "mode": "symlink", "dir": ".agents/skills", "project": { "mode": "symlink", "dir": ".agents/skills" } } },
    { "name": "Antigravity", "detect": ".antigravity", "bridge": null, "include": "",
      "skills": { "mode": "symlink", "dir": ".gemini/config/skills", "project": { "mode": "symlink", "dir": ".gemini/config/skills" } } },
    { "name": "Hermes", "detect": ".hermes", "command": "hermes", "bridge": null,
      "skills": { "mode": "config-external-dir", "configFile": ".hermes/config.yaml", "key": "skills.external_dirs",
        "project": { "mode": "config-external-dir", "configFile": ".hermes/config.yaml", "key": "skills.external_dirs" } } }
  ],
  "wellKnownSkillDirs": [
    { "name": "Agent Skills standard", "mode": "symlink", "dir": ".agents/skills", "serves": ["Codex", "Cursor", "Gemini"] }
  ],
  "retiredSkillDirs": [".cursor/skills", ".gemini/skills"]
}

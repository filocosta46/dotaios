{
  "agents": [
    { "name": "Claude Code", "detect": ".claude", "bridge": ".claude/CLAUDE.md", "include": "@",
      "skills": { "mode": "symlink", "dir": ".claude/skills" } },
    { "name": "Codex", "detect": ".codex", "bridge": ".codex/AGENTS.md", "include": "",
      "skills": { "mode": "symlink", "dir": ".agents/skills" } },
    { "name": "Gemini", "detect": ".gemini", "bridge": ".gemini/GEMINI.md", "include": "@",
      "skills": { "mode": "command", "dir": ".gemini/commands" } },
    { "name": "Hermes", "detect": ".hermes", "bridge": null,
      "skills": { "mode": "config-external-dir", "configFile": ".hermes/config.yaml", "key": "skills.external_dirs" } }
  ],
  "wellKnownSkillDirs": [
    { "name": "Agent Skills standard", "mode": "symlink", "dir": ".agents/skills", "serves": ["Codex", "Cursor", "Gemini"] }
  ]
}
